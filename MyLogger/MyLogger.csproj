
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>VishalTrivedi.MyLogger</PackageId>
    <Version>1.0.0</Version>
    <Authors>VishalTrivedi</Authors>
    <Description>Reusable logging library for .NET applications</Description>

    <PackageTags>Logging;DotNet;Logger</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <RepositoryUrl>https://github.com/VishalTrivedi2000/AzureDevOpsLearning</RepositoryUrl>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

</Project>
