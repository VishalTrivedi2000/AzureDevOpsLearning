
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>VishalTrivedi.MyLogger</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vishal Trivedi</Authors>
    <Company>Personal Learning</Company>
    <Description>A reusable logging library for .NET applications.</Description>

    <PackageTags>Logging;DotNet;Logger</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

</Project>
